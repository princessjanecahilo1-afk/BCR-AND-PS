// RESIDENT TAB SWITCHING
function switchResidentTab(tab) {
    const btnSubmit = document.getElementById('tab-btn-submit');
    const btnCommunity = document.getElementById('tab-btn-community');
    const contentSubmit = document.getElementById('tab-submit');
    const contentCommunity = document.getElementById('tab-community');

    if (tab === 'submit') {
        btnSubmit.classList.add('active');
        btnCommunity.classList.remove('active');
        contentSubmit.classList.remove('hidden');
        contentCommunity.classList.add('hidden');
    } else {
        btnCommunity.classList.add('active');
        btnSubmit.classList.remove('active');
        contentCommunity.classList.remove('hidden');
        contentSubmit.classList.add('hidden');
        renderResidentFeed();
    }
}

// SUBMIT NEW CONCERN
function submitConcern(e) {
    e.preventDefault();

    const category = document.getElementById('concern-category').value;
    const location = document.getElementById('concern-location').value;
    const description = document.getElementById('concern-description').value;

    const newConcern = {
        id: Date.now(),
        category,
        location,
        description,
        reportedBy: currentUser ? currentUser.name : "Anonymous Resident",
        date: new Date().toISOString().split('T')[0],
        status: 'Pending',
        upvotes: 1,
        votedBy: [currentUser ? currentUser.name : "Anonymous Resident"]
    };

    concerns.unshift(newConcern);
    document.getElementById('concern-form').reset();
    alert('Thank you! Your concern has been submitted successfully to Barangay Pinagturilan officials.');
    
    switchResidentTab('community');
}

// TOGGLE UPVOTE
function toggleUpvote(id) {
    const concern = concerns.find(c => c.id === id);
    if (!concern) return;

    const userName = currentUser ? currentUser.name : "Guest";
    const userIndex = concern.votedBy.indexOf(userName);
    
    if (userIndex === -1) {
        concern.upvotes += 1;
        concern.votedBy.push(userName);
    } else {
        concern.upvotes -= 1;
        concern.votedBy.splice(userIndex, 1);
    }

    if (currentUser && currentUser.role === 'resident') {
        renderResidentFeed();
    } else if (typeof renderOfficialDashboard === 'function') {
        renderOfficialDashboard();
    }
}

// RENDER RESIDENT FEED
function renderResidentFeed() {
    const container = document.getElementById('resident-feed-list');
    if (!container) return;
    
    // Sort highest upvotes first
    const sorted = [...concerns].sort((a, b) => b.upvotes - a.upvotes);

    if (sorted.length === 0) {
        container.innerHTML = `<div class="empty-state">No concerns reported yet.</div>`;
        return;
    }

    const currentUserName = currentUser ? currentUser.name : "";

    container.innerHTML = sorted.map(item => {
        const hasVoted = item.votedBy.includes(currentUserName);
        return `
            <div class="concern-item">
                <div class="upvote-box ${hasVoted ? 'voted' : ''}" onclick="toggleUpvote(${item.id})">
                    <i class="fa-solid fa-chevron-up"></i>
                    <span class="upvote-count">${item.upvotes}</span>
                    <span class="upvote-label">Upvotes</span>
                </div>
                <div class="concern-content">
                    <div class="concern-header">
                        <span class="concern-title">${item.category}</span>
                        <span class="badge ${getBadgeClass(item.status)}">${item.status}</span>
                    </div>
                    <div class="concern-meta">
                        <span><i class="fa-solid fa-location-dot"></i> ${item.location}</span>
                        <span><i class="fa-solid fa-user"></i> ${item.reportedBy}</span>
                        <span><i class="fa-solid fa-calendar"></i> ${item.date}</span>
                    </div>
                    <p class="concern-body">${item.description}</p>
                </div>
            </div>
        `;
    }).join('');
}
